# LAMMPS input for simulating collision cascade
# Parameters: atomsfile, ff_settings, mass, pka_id, v_x, v_y, v_z,
# eph_C_e, eph_kappa_e, temp, gsx, gsy, gsz, tinfile, betafile, cascade_steps 

#-------------------------INITIALIZATION--------------------------
units           metal
boundary        p p p
atom_style      atomic
read_data       {atomsfile}

#---------------------------FORCE FIELD---------------------------
{ff_settings}
mass            1  {mass}

#----------------------------PKA SETTING-------------------------
group           PKA id == {pka_id}
velocity        PKA set {v_x} {v_y} {v_z} units box

#--------------------------ADAPTIVE TIMESTEP----------------------
fix             1 all dt/reset 1 1e-6 1e-3 2e-2 emax 10 
thermo          10
thermo_style    custom step time temp press pe ke etotal

#--------------------------BORDER MONITOR-----------------------
variable        br internal {border_thickness}
region          in_region block $(xlo+v_br) $(xhi-v_br) $(ylo+v_br) $(yhi-v_br) $(zlo+v_br) $(zhi-v_br) 
region          br_region block $(xlo+v_br) $(xhi-v_br) $(ylo+v_br) $(yhi-v_br) $(zlo+v_br) $(zhi-v_br) side out

fix             prop all property/atom i_myflag
set             region in_region i_myflag 10                  # for visual checking region
set             region br_region i_myflag 20                  # can be deleted if sure the region is correct 
#group           border dynamic all region br_region every 100 # for atoms in this region, monitoring their velocity
group           border region br_region
group           inside region in_region

#--------------------------BORDER THERMOSTAT-----------------------
# fix             2 border temp/berendsen {temp} {temp} 0.1

compute         ep all pe/atom
compute         ek all ke/atom
compute         ekmax border reduce max c_ek
compute         epmax border reduce max c_ep
compute         myflag_val all property/atom i_myflag
variable        ekmaxbrdr equal c_ekmax
variable        epmaxbrdr equal c_epmax
variable        t equal "time"

compute         brtemp border temp/region br_region
variable        brtemp_val equal c_brtemp
compute         intemp inside temp/region in_region
variable        intemp_val equal c_intemp

#---------------------------UPDATED-------------------------------
compute         ekmax_all all reduce max c_ek
variable        ekmaxall equal c_ekmax_all

#------------------------------USER EPH---------------------------
fix             friction all eph 12345 7 4 1.0 {eph_C_e} {eph_kappa_e} {temp} {gsx} {gsy} {gsz} {tinfile} 100 T_out/T_out {betafile} Ge   # rho_e, c_e, k_e, t_e, nx, ny, nz are read from tinfile 
fix             out1 all print 300 "$(step) $(time) $(temp) $(f_friction[1]) $(f_friction[2]) ${{brtemp_val}} ${{intemp_val}}" file eng.out screen no
fix             out2 all print 300 "$(step) $(time) $(temp) $(pe) $(ke) $(etotal) ${{ekmaxall}} ${{epmaxbrdr}} ${{ekmaxbrdr}}" file thermo.out screen no
dump            2 all custom 300 data.output id type x y z vx vy vz c_ep c_ek c_myflag_val f_friction[1] f_friction[2] 

# -----------------------------------DANGEROUS-----------------------------------------------------
# run             {cascade_steps} every 100  " if '(${{ekmaxbrdr}} > 5 || $t >= 70.0)' then 'quit' "
# run             {cascade_steps} every 100  " if '($t >= 3)' then 'quit' "  # for Ce, Ke testing
# -----------------------------------DANGEROUS------------------------------------------------------

variable        stopcond equal "v_ekmaxbrdr>5 || v_t>=50"
fix             terminate all halt 100 v_stopcond == 1 error soft 
run             1200000

write_data      data.final

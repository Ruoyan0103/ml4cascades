# LAMMPS input for simulating collision cascade
# Parameters: atomsfile, ff_settings, mass, pka_id, v_x, v_y, v_z,
# stopping_eng, stoppingfile, cascade_steps, temp
            
variable        t_rest              equal 400
variable        dump_rest           equal 2 # ps

#-------------------------INITIALIZATION--------------------------
units           metal
boundary        p p p
atom_style      atomic
read_restart    restart.rest_v1.binary

#---------------------------FORCE FIELD---------------------------
{ff_settings}
mass            1  {mass}

#--------------------------ADAPTIVE TIMESTEP----------------------
fix             1 all dt/reset 1 1e-6 1e-3 2e-2 emax 10 
thermo          500
thermo_style    custom step time temp press pe ke etotal

#--------------------------BORDER MONITOR-----------------------
variable        br internal {border_thickness}
region          in_region block $(xlo+v_br) $(xhi-v_br) $(ylo+v_br) $(yhi-v_br) $(zlo+v_br) $(zhi-v_br) 
region          br_region block $(xlo+v_br) $(xhi-v_br) $(ylo+v_br) $(yhi-v_br) $(zlo+v_br) $(zhi-v_br) side out

fix             prop all property/atom i_myflag
set             region in_region i_myflag 10                  # for visual checking region
set             region br_region i_myflag 20                  # can be deleted if sure the region is correct 
#group           border dynamic all region br_region every 100 # for atoms in this region, monitoring their velocity
group           border region br_region
group           inside region in_region

#--------------------------BORDER THERMOSTAT-----------------------
fix             2 border temp/berendsen {temp} {temp} 0.5

compute         ep all pe/atom
compute         ek all ke/atom
compute         ekmax border reduce max c_ek
compute         epmax border reduce max c_ep
compute         myflag_val all property/atom i_myflag
variable        ekmaxbrdr equal c_ekmax
variable        t equal "time"

compute         brtemp border temp/region br_region
variable        brtemp_val equal c_brtemp
compute         intemp inside temp/region in_region
variable        intemp_val equal c_intemp

#------------------------------ BORDER TERMINATION ---------------------------
fix             border_terminate all halt 100 v_ekmaxbrdr > 5.0 error hard message yes
fix             recentering all recenter ${{xcm_init}} ${{ycm_init}} ${{zcm_init}}

#------------------------------ STOPPING ---------------------------
fix             NVE_thermo all nve       
fix             stopping all electron/stopping {cutoff_eng} {stoppingfile}
fix             out1 all print 500 "$(step) $(time) $(temp) $(pe) $(ke) $(etotal) $(f_stopping)" append thermo.out screen no title "### reset stopping_power"

#----------------------------- RUN SIMULATION ---------------------------
dump            d1 all custom 500 data.output id type x y z vx vy vz c_ep c_ek c_myflag_val 
dump_modify     d1 element Ge every/time ${{dump_rest}} first no time yes append yes

fix terminate all halt 100 v_t > ${{t_rest}} error continue
run	10000000
unfix terminate
undump d1

#----------------------------- WRITE COM AND RESTART ---------------------------
write_restart   restart.rest_v2.binary
compute         com_all all com
variable        xcm equal c_com_all[1]
variable        ycm equal c_com_all[2]
variable        zcm equal c_com_all[3]
run             0
print           "${{xcm}} ${{ycm}} ${{zcm}}" file com_s4.txt screen no
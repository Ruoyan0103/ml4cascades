# LAMMPS input for simulating collision cascade
# Parameters: atomsfile, ff_settings, mass, tinfile, betafile, cascade_steps 

#-------------------------INITIALIZATION--------------------------
units           metal
boundary        p p p
atom_style      atomic
read_data       {atomsfile}

#---------------------------FORCE FIELD---------------------------
{ff_settings}
mass            1  {mass}

#--------------------------ADAPTIVE TIMESTEP----------------------
fix             1  all dt/reset 1 1e-6 1e-3 2e-2 emax 10 

#------------------------------USER EPH---------------------------
fix             friction all eph 12345 7 4 1.0 1.0e-5 1.0e-9 300.0 9 9 9 {tinfile} 100 T_out {betafile} Ge   # rho_e, c_e, k_e, t_e, nx, ny, nz are read from tinfile 
fix             out all print 1 "$(step) $(time) $(temp) $(f_friction[1]) $(f_friction[2])" file eng.out screen no

thermo          10
thermo_style    custom step time temp press pe ke etotal
fix             out all print 1 "$(step) $(time) $(temp) $(pe) $(ke) $(etotal)" file thermo.out screen no
dump            2 all 100 output.data 
run             {cascade_steps}
unfix           friction
unfix           out
undump          2



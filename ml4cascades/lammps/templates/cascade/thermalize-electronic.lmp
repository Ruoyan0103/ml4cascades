# LAMMPS input for equilibrating the cell electronic temperature
# Parameters: atomsfile, ff_settings, mass, temp, tinfile, beta_file, equ_md_steps, eph_C_e, gsx, gsy, gsz

#-------------------------INITIALIZATION--------------------------
units           metal
boundary        p p p
atom_style      atomic
read_data       {atomsfile}

#---------------------------FORCE FIELD---------------------------
{ff_settings}
mass            1  {mass}

#---------------------------USER EPH------------------------------
timestep        0.001
fix             friction all eph 12345 4 4 1.0 {eph_C_e} {eph_C_e} {temp} {gsx} {gsy} {gsz} {tinfile} 0 T_out {beta_file} Ge   # rho_e, c_e, k_e, t_e, nx, ny, nz are read from tinfile 
fix             out1 all print 1 "$(step) $(time) $(temp) $(f_friction[1]) $(f_friction[2])" file eng.out screen no

thermo          10
thermo_style    custom step time temp press pe ke etotal
fix             out2 all print 1 "$(step) $(time) $(temp) $(pe) $(ke) $(etotal)" file thermo.out screen no

run             {equ_md_steps}
unfix           friction
unfix           out1
unfix           out2
write_data      atoms.electronic




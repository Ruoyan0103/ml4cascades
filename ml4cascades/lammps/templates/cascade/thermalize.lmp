# LAMMPS input for equilibrating the cell electronic temperature
# Parameters: atomsfile, ff_settings, mass, temp
# tinfile, beta_file, equ_md_steps, eph_C_e, eph_kappa_e, gsx, gsy, gsz

#-------------------------INITIALIZATION--------------------------
units           metal
boundary        p p p
atom_style      atomic
read_data       {atomsfile}

#---------------------------FORCE FIELD---------------------------
{ff_settings}
mass            1  {mass}

#---------------------------ATOMIC EQULIBRATION NVT+NPT------------------------------
min_style       cg
minimize        1.0e-8 1.0e-10 10000 100000

reset_timestep  0
timestep        0.001

velocity        all create {temp} 51742 mom yes rot yes dist gaussian units box

thermo          10
thermo_style    custom step time atoms temp press pe etotal lx ly lz vol

fix             1 all nvt temp {temp} {temp} 0.1 tchain 5
run             5000
unfix           1
fix             2 all npt temp {temp} {temp} 0.1 iso 0.0 0.0 1.0 tchain 5 pchain 5 drag 1.0
run             20000
unfix           2

#--------------------------USER EPH-------------------------------------------------
fix             friction all eph 12345 7 4 1.0 {eph_C_e} {eph_kappa_e} {temp} {gsx} {gsy} {gsz} {tinfile} 0 T_out {beta_file} Ge   # rho_e, c_e, k_e, t_e, nx, ny, nz are read from tinfile

fix             out all print 10 "$(step) $(time) $(temp) $(pe) $(ke) $(etotal) $(f_friction[1]) $(f_friction[2])" file eng.out screen no

run             3000
write_data      data.output




# LAMMPS input script for PKA simulation
# Parameters: ff_settings, mass, pka_id, v_x, v_y, v_z, Temp

#---------------------------------INITIALIZATION------------------------------
read_restart    ../restart.relaxed
reset_timestep  0

#-------------------------------FORCE FIELD-----------------------------------
{ff_settings}
mass            1  {mass}

#---------------------------------PKA SETTINGS---------------------------------
group           PKA id == {pka_id}
velocity        PKA set {V_x} {V_y} {V_z} units box

#------------------------------------SIMULATION---------------------------------
fix eph all eph 12345 7 4 1.0 6.242e-7 0.0692862 300 36 36 36 100 NULL {inputfiles_betafile} Ge


























#----------------------------------------- OUTPUT --------------------------------
variable        mystep equal step
variable        mytime equal time
variable        myepot equal pe
variable        myekin equal ke
variable        mytemp equal temp
variable        myetot equal etotal
compute         emaxall all reduce max c_ek
variable        myemax equal c_emaxall
fix             plot all print 100 "${{mystep}} ${{mytime}} ${{myepot}} ${{myekin}} ${{myetot}} ${{mytemp}} ${{myemax}} ${{emaxbrdr}}" screen no file data.txt title "Step Time Epot Ekin Etot Temp max_ek max_ek_border"

#---------------------------------PKA RUN--------------------------------------
run             100000 every 100  " if '(${{emaxbrdr}} > 5 || $t >= 30.0)' then 'quit' "

#---------------------------------OUTPUT FINAL-----------------------------------
write_data      struc_out.data
run             1
                







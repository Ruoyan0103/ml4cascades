! TurboGAP input file for PKA simulation
! Parameters: ff_settings, num_species, element, mass, cascade_steps, Temp, stopping_file
! Species-specific info
atoms_file = 'thermalized.xyz'
pot_file = "gap_files/Ge-v10-gap"
n_species = 1
species = Ge
masses = 72.64

! MD options
md_nsteps = 100000
md_step = 1.

! Adaptive timestep 
adaptive_time = .true.
adapt_time_groupID = all
adapt_tstep_interval = 1
adapt_tmin = 1
adapt_tmax = 100
adapt_xmax = 0.1
adapt_emax = 30

! Electronic stopping
electronic_stopping = .true. 
eel_groupID = all
eel_cut = 10
eel_freq_out = 10
estop_filename = '/scratch/phys/t30429_nume-dft-ml/04-Ruoyan/02-Paper2/02-cascade/ml4cascades/ml4cascades/turbogap/templates/pka/Ge_Ge_elstop.txt'

! Border thermostat
make_group = inside block 0 10 0 10 0 10
make_group = border subtract 2 all inside
thermostat = "berendsen"
thermostat_groupID = border
t_beg = 300
t_end = 300
tau_t = 100.

make_group = inside dynamic 100
make_group = border dynamic 100

! Writeouts
write_thermo = 100
write_xyz = 100
neighbors_buffer = 0.5

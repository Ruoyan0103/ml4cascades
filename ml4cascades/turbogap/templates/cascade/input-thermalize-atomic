! TurboGAP input file for thermalizing atomic system
! Parameters: atomsfile, ff_settings, num_species, element, mass, equ_md_steps, temp, taut
atoms_file = "{atomsfile}"
pot_file = "gap_files/{ff_settings}"
n_species = {num_species}
species = {element}
masses = {mass}

! MD options
md_nsteps = {equ_md_steps} ! 5000 steps for 5 ps
md_step = 1.               ! fs
! Temperature
thermostat = berendsen
t_beg = {temp}
t_end = {temp}
tau_t = {taut}
! Output
write_thermo = 10                 ! Write thermo every 10 steps
write_xyz = {equ_md_steps}        ! Write final structure

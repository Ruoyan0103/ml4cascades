! TurboGAP input file for PKA simulation
! Parameters: ff_settings, num_species, element, mass, cascade_steps, Temp, stopping_file
! Species-specific info
atoms_file = 'thermalized.xyz'
pot_file = "gap_files/{ff_settings}"
n_species = {num_species}
species = {element}
masses = {mass}

! MD options
md_nsteps = {cascade_steps}
md_step = 1.

! Adaptive timestep
adaptive_time = .true.
adapt_tstep_interval = 1
adapt_tmin = 1.0E-10
adapt_tmax = 1.0
adapt_xmax = 0.1
adapt_emax = 30

! Electronic stopping
electronic_stopping = .true. 
eel_cut = 10
estop_filename = '{stopping_file}'

! Border thermostat
! make_group = inside block xlow xhigh ylow yhigh zlow zhigh
! make_group = border subtract 2 all inside
! thermostat = "berendsen"
! thermostat_groupID = border
! t_beg = {Temp}
! t_end = {Temp}
! tau_t = 100.

! Writeouts
write_thermo = 100
write_xyz = 100
neighbors_buffer = 0.5

! TurboGAP input file for PKA simulation
! Parameters: ff_settings, element, mass, cascade_steps, Temp
! Parameters for EPH: beta_file, xlow, xhigh, ylow, yhigh, zlow, zhigh, eph_tin_file, eph_tout_file

! Species-specific info
atoms_file = 'thermalized.xyz'
pot_file = "gap_files/{ff_settings}"
n_species = 1
species = {element}
masses = {mass}

! MD options
md_nsteps = {cascade_steps}
md_step = 1.

! Adaptive timestep 
adaptive_time = .true.
adapt_time_groupID = all
adapt_tstep_interval = 1
adapt_tmin = 1.0E-10
adapt_tmax = 1.0E-00   ! 1 fs
adapt_xmax = 1.0E-01   ! 0.1 Angstrom
adapt_emax = 30.0      ! 30 eV

! Electronic system - eph model
nonadiabatic_processes = .true.                                        
eph_fdm_option = 1                                                     
eph_friction_option = 1                                                
eph_random_option = 1                                                  
eph_betafile = '{beta_file}'                                        

eph_box_limits = {xlow} {xhigh} {ylow} {yhigh} {zlow} {zhigh}

eph_rho_e = 1.0                       ! scaling parameter for FDM mesh                
eph_C_e = {eph_C_e}                   ! electronic heat capacity (eV/A^3/K)               
eph_kappa_e = {eph_kappa_e}           ! electronic thermal conductivity (eV/A/K/ps)
eph_Ti_e = {Temp}                     ! initial electronic temperature (K)            

! eph_Tinfile = '{eph_tin_file}'

eph_freq_Tout = 100
eph_freq_mesh_Tout = 10000
eph_Toutfile = '{eph_tout_file}'

! Writeouts
write_thermo = 100
write_xyz = 100
neighbors_buffer = 0.5

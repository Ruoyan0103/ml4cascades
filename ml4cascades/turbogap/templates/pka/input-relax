! TurboGAP input file for relaxation
! Parameters: ff_settings, num_species, element, mass, Temp
atoms_file = "data.input"
pot_file = "gap_files/{ff_settings}"
n_species = {num_species}
species = {element}
masses = {mass}

! MD options
md_nsteps = 200
md_step = 1.
 ! Temperature
thermostat = berendsen
t_beg = {Temp}
t_end = {Temp}
tau_t = 100.
 ! Pressure
barostat = berendsen
barostat_sym = diag
p_beg = 0
p_end = 0
tau_p = 1000.
gamma_p = 30.
! Output
write_thermo = 500
write_xyz = 5000
neighbors_buffer = 0.5
